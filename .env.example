# ==============================================================================
# AI Investment Assistant - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Do not commit .env to version control.
# ==============================================================================

# Google Gemini API Configuration (Required for AI Analysis and Assistant)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Flask Application Security (Recommended)
# Used for cryptographically signing session cookies in the web dashboard
FLASK_SECRET_KEY=generate_a_random_secret_key_here

# Daily Portfolio Briefing Email Notifications (Optional - Gmail SMTP)
# Requires a Gmail App Password if 2-Factor Authentication is enabled on your Google account
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
RECIPIENT_EMAIL=recipient_email@example.com

# Automated Batch Mode Configuration (Optional)
# Allows overriding portfolio state via a JSON string during headless execution
# PORTFOLIO_JSON={"positions": {}}
